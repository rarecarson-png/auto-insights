    {
      "number": 5,
      "title": "Aggregation",
      "description": "Summarize dataset coverage and available-case averages. COUNT(column) shows each numeric denominator.",
      "sql": "SELECT COUNT(*) AS records,\n       MIN(year) AS earliest_year, MAX(year) AS latest_year,\n       COUNT(msrp) AS price_records,\n       ROUND(AVG(msrp), 2) AS avg_msrp,\n       COUNT(engine_hp) AS hp_records,\n       ROUND(AVG(engine_hp), 2) AS avg_hp\nFROM vehicles;",
      "fields": [
        "records",
        "earliest_year",
        "latest_year",
        "price_records",
        "avg_msrp",
        "hp_records",
        "avg_hp"
