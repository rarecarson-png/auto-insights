    {
      "number": 8,
      "title": "JOIN",
      "description": "Join vehicle records to a transmission lookup, then compare average highway MPG in the eligible fuel-economy subset. This result supplies Visualization 2.",
      "sql": "SELECT t.transmission_name, COUNT(*) AS records,\n       ROUND(AVG(v.highway_mpg), 2) AS avg_highway_mpg\nFROM vehicles AS v\nJOIN transmissions AS t ON v.transmission_id = t.transmission_id\nWHERE v.fuel_economy_analysis_ready = 1\nGROUP BY t.transmission_id, t.transmission_name\nORDER BY avg_highway_mpg DESC, t.transmission_name ASC;",
      "fields": [
        "transmission_name",
        "records",
        "avg_highway_mpg"
